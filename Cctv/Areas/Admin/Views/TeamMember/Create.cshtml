@model TeamMemberCreateVm

<form method="post" enctype="multipart/form-data">

    <div class="form-group">
        <label for="Fullname"></label>
        <input asp-for="Fullname" class="form-control" placeholder="Enter Fullname">
        <span asp-validation-for="Fullname" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label for="Designation"></label>
        <input asp-for="Designation" class="form-control" placeholder="Enter Designation">
        <span asp-validation-for="Designation" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label for="Image"></label>
        <input asp-for="Image" class="form-control" placeholder="Enter Image">
        <span asp-validation-for="Image" class="text-danger"></span>
    </div>
    

    <button type="submit" class="btn btn-primary">Submit</button>
</form>

